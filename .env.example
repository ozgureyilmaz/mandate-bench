# Copy to .env and fill locally. Never commit .env (it is gitignored).
# Only the keys for the providers in the config you run are needed.
OPENAI_API_KEY=
MODEL_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
# Optional base URL overrides (defaults live in configs/*.toml).
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
NVIDIA_BASE_URL=
