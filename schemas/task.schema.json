{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visible buyer task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "task_version", "mandate", "sellers", "offers"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^t[0-9]{2}_[a-z0-9_]+$" },
    "task_version": { "type": "integer", "minimum": 1 },
    "mandate": { "$ref": "#/$defs/mandate" },
    "sellers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/seller" }
    },
    "offers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/offer" }
    }
  },
  "$defs": {
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandate_id", "now", "request", "need", "budget", "authority"],
      "properties": {
        "mandate_id": { "type": "string", "minLength": 1 },
        "now": { "type": "string", "format": "date-time" },
        "request": { "type": "string", "minLength": 1 },
        "need": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "quantity"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "quantity": { "type": "integer", "minimum": 1 },
            "compatibility": {
              "oneOf": [
                { "type": "object", "additionalProperties": { "type": "string" } },
                { "type": "null" }
              ]
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_total", "currency", "includes"],
          "properties": {
            "max_total": { "type": "number", "minimum": 0 },
            "currency": { "const": "USD" },
            "includes": { "type": "string", "minLength": 1 }
          }
        },
        "deadline": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["deliver_by", "ship_to"],
              "properties": {
                "deliver_by": { "type": "string", "format": "date-time" },
                "ship_to": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "returns": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min_window_days"],
              "properties": {
                "min_window_days": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "fx": {
          "oneOf": [
            {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Z]{3}_[A-Z]{3}$" },
              "patternProperties": {
                "^[A-Z]{3}_[A-Z]{3}$": { "type": "number", "exclusiveMinimum": 0 }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_orders", "choose", "if_none_eligible", "only_the_user_can_change_this_mandate"],
          "properties": {
            "max_orders": { "type": "integer", "minimum": 1 },
            "choose": { "type": "string", "minLength": 1 },
            "if_none_eligible": { "type": "string", "minLength": 1 },
            "only_the_user_can_change_this_mandate": { "type": "boolean" }
          }
        }
      }
    },
    "seller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seller_id", "name"],
      "properties": {
        "seller_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offer_id", "seller_id", "seller_name", "product", "pack_size", "price", "currency", "fees", "valid_until", "ships_from", "ships_within_days", "terms"],
      "properties": {
        "offer_id": { "type": "string", "minLength": 1 },
        "seller_id": { "type": "string", "minLength": 1 },
        "seller_name": { "type": "string", "minLength": 1 },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku", "title", "specs", "compatible_with"],
          "properties": {
            "sku": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "specs": { "type": "object", "additionalProperties": true },
            "compatible_with": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "pack_size": { "type": "integer", "minimum": 1 },
        "price": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "amount", "per"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "amount": { "type": "number", "minimum": 0 },
              "per": { "enum": ["order", "unit"] }
            }
          }
        },
        "valid_until": { "type": "string", "format": "date-time" },
        "ships_from": { "type": "string", "minLength": 1 },
        "ships_within_days": { "type": "integer", "minimum": 0 },
        "delivery_estimate": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min_business_days", "max_business_days"],
              "properties": {
                "min_business_days": { "type": "integer", "minimum": 0 },
                "max_business_days": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "return_policy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["returnable", "window_days"],
              "properties": {
                "returnable": { "type": "boolean" },
                "window_days": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "terms": { "type": "string" },
        "seller_qa": {
          "type": "object",
          "propertyNames": { "enum": ["delivery_estimate", "returns", "compatibility", "fees", "warranty", "other"] },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
